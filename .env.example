# ==========================================
# LEADFORGEAI ENVIRONMENT CONFIGURATION
# ==========================================

# General Application Config
ENV=development
DEBUG=true
PROJECT_NAME="LeadForgeAI"
SECRET_KEY="replace-this-with-a-very-secure-random-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server Config
HOST=0.0.0.0
PORT=8000

# Frontend Client Config (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Database Connection (MongoDB)
MONGODB_URL=mongodb://leadforge:leadforge_password@db:27017/leadforge_db?authSource=admin
MONGODB_DB_NAME=leadforge_db

# Cache / Task Queue (Redis)
REDIS_URL=redis://redis:6379/0

# LLM Providers API Keys Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Multi-Agent LLM Model Architecture Routing
MANAGER_AGENT_PROVIDER=openrouter
MANAGER_AGENT_MODEL=nvidia/nemotron-3-ultra

PLANNER_AGENT_PROVIDER=groq
PLANNER_AGENT_MODEL=gpt-oss-20b

SCRAPER_AGENT_PROVIDER=ollama
SCRAPER_AGENT_MODEL=qwen3:4b

RESEARCH_AGENT_PROVIDER=groq
RESEARCH_AGENT_MODEL=llama-3.3-70b

WEBSITE_ANALYZER_PROVIDER=ollama
WEBSITE_ANALYZER_MODEL=gemma3:12b

FALLBACK_PROVIDER=openrouter
FALLBACK_MODEL=openrouter/free

# Scraper Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Bookipi API Integration (Mock/Partner credentials)
BOOKIPI_API_KEY=your_bookipi_api_key_here
BOOKIPI_PARTNER_ID=your_bookipi_partner_id_here


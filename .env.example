# ==========================================
# LEADFORGEAI ENVIRONMENT CONFIGURATION
# ==========================================

# General Application Config
ENV=development
DEBUG=true
PROJECT_NAME="LeadForgeAI"
SECRET_KEY="replace-this-with-a-very-secure-random-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server Config
HOST=0.0.0.0
PORT=8000

# Frontend Client Config (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Database Connection (MongoDB)
MONGODB_URL=mongodb://leadforge:leadforge_password@db:27017/leadforge_db?authSource=admin
MONGODB_DB_NAME=leadforge_db

# Cache / Task Queue (Redis)
REDIS_URL=redis://redis:6379/0

# LLM Providers Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Scraper Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Bookipi API Integration (Mock/Partner credentials)
BOOKIPI_API_KEY=your_bookipi_api_key_here
BOOKIPI_PARTNER_ID=your_bookipi_partner_id_here

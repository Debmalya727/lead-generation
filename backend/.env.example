APP_NAME=LeadForgeAI
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=leadforge

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Providers Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Multi-Agent LLM Model Architecture Routing
MANAGER_AGENT_PROVIDER=openrouter
MANAGER_AGENT_MODEL=nvidia/nemotron-3-ultra

PLANNER_AGENT_PROVIDER=groq
PLANNER_AGENT_MODEL=gpt-oss-20b

SCRAPER_AGENT_PROVIDER=ollama
SCRAPER_AGENT_MODEL=qwen3:4b

RESEARCH_AGENT_PROVIDER=groq
RESEARCH_AGENT_MODEL=llama-3.3-70b

WEBSITE_ANALYZER_PROVIDER=ollama
WEBSITE_ANALYZER_MODEL=gemma3:12b

FALLBACK_PROVIDER=openrouter
FALLBACK_MODEL=openrouter/free